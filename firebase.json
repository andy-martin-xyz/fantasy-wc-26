{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "cmd/**",
      "internal/**",
      "go.mod",
      "go.sum",
      "Dockerfile",
      "dev.sh",
      "seed.sh",
      "*.md"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "fantasy-league-api",
          "region": "us-central1"
        }
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
