# Copy this file to .env and fill in your values.
# Get Firebase values from: Firebase Console → Project Settings → Your Apps
# .env is gitignored — never commit the real values.

# Firebase web app config (used to generate public/js/config.js at runtime)
FIREBASE_API_KEY=YOUR_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID

# Backend config
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
ADMIN_EMAILS=your@email.com

# API-Football (Phase 6 live scoring). Free key: dashboard.api-football.com
# or via RapidAPI (pass -rapidapi to cmd/apifootball-ids). Used to resolve each
# player's apiFootballId and, later, pull live match stats.
API_FOOTBALL_KEY=YOUR_API_FOOTBALL_KEY
