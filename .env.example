# Copy this file to .env and fill in your values.
# Get Firebase values from: Firebase Console → Project Settings → Your Apps
# .env is gitignored — never commit the real values.

# Firebase web app config (used to generate public/js/config.js at runtime)
FIREBASE_API_KEY=YOUR_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID

# Backend config
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
ADMIN_EMAILS=your@email.com

# Firebase service account key. Local dev always verifies against your real
# Firebase Auth (there's no Auth emulator wiring — only Firestore is
# emulated), so the backend needs real credentials even in dev.
# Get one from: Firebase Console → Project Settings → Service Accounts →
# Generate new private key. Save it as keys/service-account.json (gitignored)
# — the default below matches scripts/dev.sh and docker-compose.yml.
GOOGLE_APPLICATION_CREDENTIALS=./keys/service-account.json

# Optional: enables AI pick suggestions (POST /api/draft/suggest) via the
# Anthropic API. Falls back to local rating-based logic if unset.
# ANTHROPIC_API_KEY=sk-ant-...
